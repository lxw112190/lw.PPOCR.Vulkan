{
  "metadata_version": 1,
  "version": "@LWVK_VERSION@",
  "source_revision": "@LWVK_SOURCE_REVISION@",
  "source_dirty": @LWVK_SOURCE_DIRTY@,
  "system": "@CMAKE_SYSTEM_NAME@",
  "processor": "@CMAKE_SYSTEM_PROCESSOR@",
  "pointer_bytes": @CMAKE_SIZEOF_VOID_P@,
  "configuration": "$<CONFIG>",
  "compiler": "@CMAKE_CXX_COMPILER_ID@",
  "compiler_version": "@CMAKE_CXX_COMPILER_VERSION@",
  "cmake_version": "@CMAKE_VERSION@",
  "vulkan_headers_version": "@Vulkan_VERSION@",
  "sanitizers": "@LWVK_SANITIZERS@",
  "experimental_coop": "@LWVK_EXPERIMENTAL_COOP@",
  "experimental_rec_lanes": "@LWVK_EXPERIMENTAL_REC_LANES@"
}
