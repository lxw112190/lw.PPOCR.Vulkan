#version 450
#extension GL_EXT_control_flow_attributes : require
// Apache-2.0, lw.PPOCR.Vulkan 2026. FP32 M32/N64/K32 implicit GEMM.
// Four adjacent NHWC channels share one spatial address calculation/load/store.
// Dispatch requires Cin/Cout divisible by four, and 16-byte-aligned tensors.
// K traversal, accumulation and activation order match conv_gemm_tiled exactly.
layout(local_size_x = 128) in;
layout(binding = 0, std430) readonly buffer X { vec4 x[]; };
layout(binding = 1, std430) readonly buffer W { vec4 w[]; };
layout(binding = 2, std430) readonly buffer B { vec4 b[]; };
layout(binding = 3, std430) writeonly buffer O { vec4 o[]; };
layout(push_constant) uniform PC {
    uint outW; uint outH; uint Cout; uint Cin; uint kH; uint kW; uint sh; uint sw;
    uint pt; uint pl; uint inW; uint inH; uint flags;
} p;
shared float aa[1024];
shared vec4 bb[512];
void main() {
    uint lid = gl_LocalInvocationID.x, m0 = gl_WorkGroupID.x * 32, n0 = gl_WorkGroupID.y * 64;
    uint mr = (lid / 16) * 4, nv = lid % 16;
    uint N4 = p.Cout / 4, C4 = p.Cin / 4, M = p.outW * p.outH, K = p.Cin * p.kH * p.kW;
    vec4 a = vec4(0), c = vec4(0), d = vec4(0), e = vec4(0);
    for (uint k0 = 0; k0 < K; k0 += 32) {
        // Every vec4 stays within one pixel even for Cin smaller than 32.
        // Zero padded pixels/tail tiles; all lanes reach both barriers.
        for (uint i = lid; i < 256; i += 128) {
            uint m = m0 + i / 8, k = k0 + (i % 8) * 4, ci = k % p.Cin, sp = k / p.Cin;
            int iy = int((m / p.outW) * p.sh + sp / p.kW) - int(p.pt);
            int ix = int((m % p.outW) * p.sw + sp % p.kW) - int(p.pl);
            vec4 v = (m < M && k < K && iy >= 0 && iy < int(p.inH) && ix >= 0 && ix < int(p.inW))
                ? x[(uint(iy) * p.inW + uint(ix)) * C4 + ci / 4] : vec4(0);
            aa[i * 4] = v.x; aa[i * 4 + 1] = v.y;
            aa[i * 4 + 2] = v.z; aa[i * 4 + 3] = v.w;
        }
        for (uint i = lid; i < 512; i += 128) {
            uint k = k0 + i / 16, n4 = n0 / 4 + i % 16;
            bb[i] = (k < K && n4 < N4) ? w[k * N4 + n4] : vec4(0);
        }
        barrier();
        [[unroll]] for (uint k = 0; k < 32; ++k) {
            vec4 v = bb[k * 16 + nv];
            a += aa[(mr + 0) * 32 + k] * v;
            c += aa[(mr + 1) * 32 + k] * v;
            d += aa[(mr + 2) * 32 + k] * v;
            e += aa[(mr + 3) * 32 + k] * v;
        }
        barrier();
    }
    uint n4 = n0 / 4 + nv, m = m0 + mr;
    if (n4 >= N4) return;
    vec4 bias = (p.flags & 1u) != 0 ? b[n4] : vec4(0);
    a += bias; c += bias; d += bias; e += bias;
    if ((p.flags & 16u) != 0) { a = max(a, vec4(0)); c = max(c, vec4(0)); d = max(d, vec4(0)); e = max(e, vec4(0)); }
    if ((p.flags & 32u) != 0) { a = lwvk_gelu(a); c = lwvk_gelu(c); d = lwvk_gelu(d); e = lwvk_gelu(e); }
    if (m < M) o[m * N4 + n4] = a;
    if (m + 1 < M) o[(m + 1) * N4 + n4] = c;
    if (m + 2 < M) o[(m + 2) * N4 + n4] = d;
    if (m + 3 < M) o[(m + 3) * N4 + n4] = e;
}
