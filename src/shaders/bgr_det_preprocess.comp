#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// Packed BGR bytes, no optional 8-bit storage feature. Header: width, height, stride,
// five reserved words; payload begins at word 8. Host pads the last uint word.
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer Source { uint words[]; } src;
layout(binding = 1, std430) writeonly buffer Destination { float values[]; } dst;
layout(push_constant) uniform Size { uint height; uint width; } out_size;
double byte_at(uint x, uint y, uint c) {
    uint offset = y * src.words[2] + x * 3 + c;
    return double((src.words[8 + offset / 4] >> ((offset % 4) * 8)) & 255u);
}
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= out_size.height * out_size.width * 3) return;
    uint c = id % 3, x = (id / 3) % out_size.width, y = id / (3 * out_size.width);
    // Preserve the CPU reference's half-pixel, clamp, BGR and double arithmetic.
    // Only preprocessing uses FP64; storage and all network shaders remain FP32.
    precise double sx = (double(x) + 0.5lf) * double(src.words[0]) / double(out_size.width) - 0.5lf;
    precise double sy = (double(y) + 0.5lf) * double(src.words[1]) / double(out_size.height) - 0.5lf;
    int ix = int(floor(sx)), iy = int(floor(sy));
    uint x0 = uint(clamp(ix, 0, int(src.words[0]) - 1));
    uint x1 = uint(clamp(ix + 1, 0, int(src.words[0]) - 1));
    uint y0 = uint(clamp(iy, 0, int(src.words[1]) - 1));
    uint y1 = uint(clamp(iy + 1, 0, int(src.words[1]) - 1));
    precise double fx = sx - double(ix), fy = sy - double(iy);
    precise double tl = byte_at(x0, y0, c), tr = byte_at(x1, y0, c);
    precise double bl = byte_at(x0, y1, c), br = byte_at(x1, y1, c);
    precise double top = tl + (tr - tl) * fx;
    precise double bottom = bl + (br - bl) * fx;
    precise double value = (top + (bottom - top) * fy) / 255.0lf;
    const double mean[3] = double[3](0.485lf, 0.456lf, 0.406lf);
    const double inv_std[3] = double[3](1.0lf / 0.229lf, 1.0lf / 0.224lf, 1.0lf / 0.225lf);
    precise double normalized = (value - mean[c]) * inv_std[c];
    dst.values[id] = float(normalized); // physical NHWC, directly consumed by DET
}
