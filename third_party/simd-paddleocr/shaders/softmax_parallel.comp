#version 450
// Apache-2.0, lw.PPOCR.Vulkan 2026. Parallel FP32 output softmax.
// One bounded workgroup per row; three passes, no per-class scratch buffer.
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer X {float x[];};
layout(set=0,binding=1) writeonly buffer O {float y[];};
layout(push_constant) uniform PC {uint rows;uint cols;}p;
shared float red[256];
void main(){
 uint r=gl_WorkGroupID.x,l=gl_LocalInvocationID.x,b=r*p.cols;
 float m=-3.402823466e38;
 for(uint c=l;c<p.cols;c+=256)m=max(m,x[b+c]);
 red[l]=m;barrier();
 for(uint s=128;s>0;s>>=1){if(l<s)red[l]=max(red[l],red[l+s]);barrier();}
 m=red[0];barrier();
 float sum=0;for(uint c=l;c<p.cols;c+=256)sum+=exp(x[b+c]-m);
 red[l]=sum;barrier();
 for(uint s=128;s>0;s>>=1){if(l<s)red[l]+=red[l+s];barrier();}
 float inv=1/red[0];
 for(uint c=l;c<p.cols;c+=256)y[b+c]=exp(x[b+c]-m)*inv;
}
