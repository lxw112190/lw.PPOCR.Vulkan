#version 450
#extension GL_EXT_control_flow_attributes : require
// Project-written FP32 implicit GEMM, Apache-2.0, lw.PPOCR.Vulkan 2026.
// M32 N64 K32 tile; K=(kernel position, input channel) for coalesced NHWC loads.
// Weights are packed once in K-major order. 4x4 register tile, 12 KiB shared.
layout(local_size_x=128)in;
layout(set=0,binding=0)readonly buffer X{float x[];};
layout(set=0,binding=1)readonly buffer W{vec4 w[];};
layout(set=0,binding=2)readonly buffer B{float b[];};
layout(set=0,binding=3)writeonly buffer O{float o[];};
layout(push_constant)uniform PC{
 uint outW;uint outH;uint Cout;uint Cin;uint kH;uint kW;uint sh;uint sw;
 uint pt;uint pl;uint inW;uint inH;uint flags;
}p;
shared float aa[1024];shared vec4 bb[512];
void main(){
 uint lid=gl_LocalInvocationID.x,m0=gl_WorkGroupID.x*32,n0=gl_WorkGroupID.y*64;
 uint mr=(lid/16)*4,nv=lid%16,N4=(p.Cout+3)/4,M=p.outW*p.outH,K=p.Cin*p.kH*p.kW;
 vec4 a=vec4(0),c=vec4(0),d=vec4(0),e=vec4(0);
 for(uint k0=0;k0<K;k0+=32){
  for(uint i=lid;i<1024;i+=128){uint m=m0+i/32,k=k0+i%32,ci=k%p.Cin,sp=k/p.Cin;
   int iy=int((m/p.outW)*p.sh+sp/p.kW)-int(p.pt),ix=int((m%p.outW)*p.sw+sp%p.kW)-int(p.pl);
   aa[i]=(m<M && k<K && iy>=0 && iy<int(p.inH) && ix>=0 && ix<int(p.inW))?x[(uint(iy)*p.inW+uint(ix))*p.Cin+ci]:0;
  }
  for(uint i=lid;i<512;i+=128){uint k=k0+i/16,n4=n0/4+i%16;bb[i]=(k<K && n4<N4)?w[k*N4+n4]:vec4(0);}
  barrier();
  [[unroll]] for(uint k=0;k<32;++k){vec4 v=bb[k*16+nv];a+=aa[(mr+0)*32+k]*v;c+=aa[(mr+1)*32+k]*v;d+=aa[(mr+2)*32+k]*v;e+=aa[(mr+3)*32+k]*v;}
  barrier();
 }
 for(uint j=0;j<4;++j){uint n=n0+nv*4+j;if(n>=p.Cout)break;
  vec4 v=vec4(a[j],c[j],d[j],e[j])+((p.flags&1u)!=0?b[n]:0);if((p.flags&16u)!=0)v=max(v,vec4(0));uint m=m0+mr;
  if(m<M)o[m*p.Cout+n]=v.x;if(m+1<M)o[(m+1)*p.Cout+n]=v.y;
  if(m+2<M)o[(m+2)*p.Cout+n]=v.z;if(m+3<M)o[(m+3)*p.Cout+n]=v.w;
 }
}
