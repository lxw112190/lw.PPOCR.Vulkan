#version 450
#extension GL_EXT_control_flow_attributes : require
// Project-written FP32 GEMM, Apache-2.0, lw.PPOCR.Vulkan 2026.
// NHWC activations and K-major, 4-channel-padded weights; M32 N64 K32 tile.
// 128 threads each keep a 4x4 register tile; 12 KiB shared memory.
layout(local_size_x=128)in;
layout(set=0,binding=0)readonly buffer X{float x[];};
layout(set=0,binding=1)readonly buffer W{vec4 w[];};
layout(set=0,binding=2)readonly buffer B{float b[];};
layout(set=0,binding=3)writeonly buffer O{float o[];};
layout(push_constant)uniform PC{uint M;uint N;uint K;uint flags;}p;
shared float aa[1024];
shared vec4 bb[512];
void main(){
 uint lid=gl_LocalInvocationID.x,m0=gl_WorkGroupID.x*32,n0=gl_WorkGroupID.y*64;
 uint mr=(lid/16)*4,nv=lid%16,N4=(p.N+3)/4;
 vec4 a=vec4(0),c=vec4(0),d=vec4(0),e=vec4(0);
 for(uint k0=0;k0<p.K;k0+=32){
  for(uint i=lid;i<1024;i+=128){uint m=m0+i/32,k=k0+i%32;aa[i]=(m<p.M && k<p.K)?x[m*p.K+k]:0;}
  for(uint i=lid;i<512;i+=128){uint k=k0+i/16,n4=n0/4+i%16;bb[i]=(k<p.K && n4<N4)?w[k*N4+n4]:vec4(0);}
  barrier();
  [[unroll]] for(uint k=0;k<32;++k){vec4 v=bb[k*16+nv];a+=aa[(mr+0)*32+k]*v;c+=aa[(mr+1)*32+k]*v;d+=aa[(mr+2)*32+k]*v;e+=aa[(mr+3)*32+k]*v;}
  barrier();
 }
 for(uint j=0;j<4;++j){uint n=n0+nv*4+j;if(n>=p.N)break;
  vec4 v=vec4(a[j],c[j],d[j],e[j])+((p.flags&1u)!=0?b[n]:0);if((p.flags&16u)!=0)v=max(v,vec4(0));
  uint m=m0+mr;
  if(m<p.M)o[m*p.N+n]=v.x;if(m+1<p.M)o[(m+1)*p.N+n]=v.y;
  if(m+2<p.M)o[(m+2)*p.N+n]=v.z;if(m+3<p.M)o[(m+3)*p.N+n]=v.w;
 }
}
